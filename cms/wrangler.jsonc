{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "localbridge-cms",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "local.bizhelp.kr/admin*", "zone_name": "bizhelp.kr" },
    { "pattern": "local.bizhelp.kr/cms-api*", "zone_name": "bizhelp.kr" },
    { "pattern": "local.bizhelp.kr/_next/*", "zone_name": "bizhelp.kr" }
  ],
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "localbridge",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "remote": true
    }
  ],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "localbridge-media", "remote": true }]
}
