{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "localbridge-web",
  "main": "src/worker.js",
  "compatibility_date": "2025-08-15",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "placement": { "region": "gcp:asia-northeast3" },
  "routes": [{ "pattern": "local.bizhelp.kr/*", "zone_name": "bizhelp.kr" }],
  "triggers": { "crons": ["*/30 * * * *"] },
  "d1_databases": [
    { "binding": "D1", "database_name": "localbridge", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "ratelimits": [{ "name": "LIMIT", "namespace_id": "4001", "simple": { "limit": 10, "period": 60 } }],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "localbridge-media" }]
}
